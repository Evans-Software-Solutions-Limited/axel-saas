    "./badge": "./src/badge.tsx",
    "./button": "./src/button.tsx",
    "./card": "./src/card.tsx",
    "./combobox": "./src/combobox.tsx",
    "./dialog": "./src/dialog.tsx",
    "./dropdown-menu": "./src/dropdown-menu.tsx",
    "./field": "./src/field.tsx",
    "./input-group": "./src/input-group.tsx",
    "./input": "./src/input.tsx",
    "./label": "./src/label.tsx",
    "./select": "./src/select.tsx",
    "./separator": "./src/separator.tsx",
    "./table": "./src/table.tsx",
