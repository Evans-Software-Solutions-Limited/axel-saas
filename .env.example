# =============================================================================
# Environment variables — single source of truth for the whole monorepo
# =============================================================================
#
# --- Infra / CI-CD -----------------------------------------------------------
# All vars below are read at deploy time by SST (sst deploy).
# Set them as GitHub Actions environment variables (vars.*) in each environment
# (Settings → Environments → Production / Staging).
# SST injects the VITE_* vars into the frontend build automatically via
# infra/web.ts — no separate packages/web/.env is needed in CI.
#
# For local development, create packages/web/.env with the VITE_* vars that
# Vite needs (VITE_SUPABASE_URL, VITE_SUPABASE_ANON_KEY, VITE_CORE_API_URL).
#
# --- SST-managed secrets -----------------------------------------------------
# These are NOT set via env vars — use `sst secret set <name> <value>` once
# per stage, then they are injected automatically at deploy and runtime.
#
#   sst secret set AxelSaasSupabaseDatabaseUrl <value>   # DATABASE_URL in Lambda
#   sst secret set AxelSaasJwtSecret           <value>   # JWT_SECRET in Lambda
#   sst secret set AxelSaasStripeSecretKey     <value>   # STRIPE_SECRET_KEY in Lambda
#   sst secret set AxelSaasStripeWebhookSecret <value>   # STRIPE_WEBHOOK_SECRET in Lambda
# =============================================================================

# -----------------------------------------------------------------------------
# Supabase
# -----------------------------------------------------------------------------

# Project URL — passed to the Lambda (JWT JWKS verification) and injected into
# the frontend build as VITE_SUPABASE_URL by infra/web.ts.
SUPABASE_URL=https://<project-ref>.supabase.co

# Public anon key — injected into the frontend build as VITE_SUPABASE_ANON_KEY
# by infra/web.ts. Safe to store in GitHub Actions vars (not secrets).
SUPABASE_ANON_KEY=<anon-key-from-supabase-dashboard>

# -----------------------------------------------------------------------------
# AWS / SST
# -----------------------------------------------------------------------------

# AWS region to deploy into (defaults to eu-west-2 if not set).
AWS_REGION=eu-west-2
