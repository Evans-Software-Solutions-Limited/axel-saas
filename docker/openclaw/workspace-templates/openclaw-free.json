{
  "gateway": {
    "mode": "local",
    "bind": "lan",
    "port": 18789,
    "controlUi": {
      "dangerouslyAllowHostHeaderOriginFallback": true
    },
    "http": {
      "endpoints": {
        "chatCompletions": {
          "enabled": true
        }
      }
    }
  },
  "agents": {
    "defaults": {
      "workspace": "/data/workspace",
      "model": {
        "primary": "anthropic/haiku"
      }
    }
  },
  "plugins": {
    "entries": {
      "axel-bridge": {
        "enabled": true,
        "config": {
          "chatCompletionsBaseUrl": "http://127.0.0.1:18789",
          "defaultModel": "openclaw"
        }
      }
    }
  }
}
